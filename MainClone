void loadFromFile(string *names, double *gpas, int &count){
	Ifstream inFile(FILE_NAME);
	If (!inFile) {
		Return;
}


*count = 0;
While (*count < MAX_STUDENT && getline(inFile, *(names + *count))) {
	If ((*(names + *count)).empty()) continue;
	If (inFile >> *(gpas + count)) {
		inFile.ignore(1000, '\n');
		(*count)++;
		}
}
inFile.close();
}


